# ==============================================================================
# Personal Operations Hub - Production Environment Template (.env.production.example)
# Use this configuration for self-hosted VPS, Docker Compose, or Linux hosts
# ==============================================================================

# Core Application Security
APP_NAME="Personal Operations Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://operations.your-domain.com

# User Registration Control (Private Single-User Mode)
# Keep 'false' in production to block registration routes and prevent unauthorized users
ALLOW_REGISTRATION=false

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging (Daily rotating logs with 14-day retention)
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Production Database (SQLite with WAL mode and concurrency hardening)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite
RUN_MIGRATIONS=true

# Session Security (Enforce HTTPS-only, encrypted database sessions)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true

# Cache & Queues (Persistent database drivers)
CACHE_STORE=database
QUEUE_CONNECTION=database

# Filesystem & Storage
FILESYSTEM_DISK=local

# Automated Backup Encryption
# Generate a strong 32+ character random string for AES-256 backup encryption:
# openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=

# Docker Compose Specific (Caddy Reverse Proxy Domain)
POH_DOMAIN=operations.your-domain.com
POH_HTTP_PORT=80
POH_HTTPS_PORT=443

# Mail Configuration (Defaults to log; configure SMTP for real email delivery)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Build Variables
VITE_APP_NAME="${APP_NAME}"
