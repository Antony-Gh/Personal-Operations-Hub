#!/usr/bin/env sh
# ==============================================================================
# Personal Operations Hub - Unified Cross-Platform Dispatcher (./poh)
# Automatically routes commands to controller.ps1 on Windows or controller.sh on Unix
# ==============================================================================
set -e

# Resolve script root directory
ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT_DIR"

detect_environment() {
    case "$(uname -s 2>/dev/null || echo Windows)" in
        CYGWIN*|MINGW*|MSYS*)
            echo "windows-shell"
            ;;
        Linux*)
            if grep -qi microsoft /proc/version 2>/dev/null; then
                echo "wsl"
            else
                echo "linux"
            fi
            ;;
        Darwin*)
            echo "macos"
            ;;
        *)
            echo "unknown"
            ;;
    esac
}

ENV_TYPE="$(detect_environment)"

# Handle explicit --windows flag in WSL or hybrid shells
if [ "$1" = "--windows" ]; then
    shift
    if command -v powershell.exe >/dev/null 2>&1; then
        exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ROOT_DIR/controller.ps1" "$@"
    else
        echo "[ERROR] powershell.exe not found in PATH." >&2
        exit 1
    fi
fi

if [ "$ENV_TYPE" = "windows-shell" ]; then
    if command -v powershell.exe >/dev/null 2>&1; then
        exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ROOT_DIR/controller.ps1" "$@"
    fi
fi

# On Linux, macOS, or WSL native, delegate to controller.sh
if [ -f "$ROOT_DIR/controller.sh" ]; then
    exec "$ROOT_DIR/controller.sh" "$@"
else
    echo "[ERROR] controller.sh not found at $ROOT_DIR/controller.sh" >&2
    exit 1
fi
