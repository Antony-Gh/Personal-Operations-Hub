# Application Configuration
APP_NAME="Personal Operations Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# User Registration Control (true to allow new account creation; false to enforce single-user private mode)
ALLOW_REGISTRATION=false

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database Connection (sqlite for local dev; pgsql or mysql for production cloud deployment)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=personal_operations_hub
DB_USERNAME=poh_user
DB_PASSWORD=
DB_SSLMODE=prefer

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Cache & Queues
CACHE_STORE=database
QUEUE_CONNECTION=database

# Filesystem & Storage
FILESYSTEM_DISK=local

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Build Variables
VITE_APP_NAME="${APP_NAME}"
